{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Loopback operator console permissions for the main window",
  "windows": ["main"],
  "platforms": ["macOS"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1:8080" },
        { "url": "http://127.0.0.1:8080/*" },
        { "url": "http://127.0.0.1:8222" },
        { "url": "http://127.0.0.1:8222/*" }
      ]
    },
    "websocket:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "mister-smith-runtime",
          "sidecar": true,
          "args": ["run"]
        }
      ]
    }
  ]
}
